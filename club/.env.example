# Copy this file to .env and fill in real values.
# cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string (pooled, e.g. via PgBouncer/Supabase pooler)
DATABASE_URL="postgresql://user:password@host:5432/club"
# Direct (non-pooled) connection, used by Prisma for migrations/db push
DIRECT_URL="postgresql://user:password@host:5432/club"

# Secret used to sign auth JWTs — generate with: openssl rand -base64 32
JWT_SECRET=""

# Public URL of the deployed app (used in emails, redirects, CORS-safe links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis — required for rate limiting on auth endpoints
# (login, register, reset-password, resend-code, verify). Without these,
# those routes will error at request time. Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Image uploads (Cloudinary) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (SMTP) — falls back to console logging in dev if unset ───────────
SMTP_URL=""
SMTP_FROM=""

# ── Google OAuth login ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ── Payments (Konnect Network — Tunisian payment gateway) ──────────────────
KONNECT_API_KEY=""
KONNECT_BASE_URL=""
KONNECT_WALLET_ID=""

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret checked on scheduled endpoints (e.g. session reminders)
CRON_SECRET=""